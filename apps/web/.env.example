# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
ANTHROPIC_API_KEY=
# Optional: override default model (defaults to claude-sonnet-4.5)
AI_MODEL=

# Admin
# Email address of the single admin user (must match a Supabase auth user)
ADMIN_EMAIL=
# Static API key for machine-to-machine endpoints (e.g. /api/admin/sms-usage)
ADMIN_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clinic
# Optional: display name shown in AI prompts (defaults to V-Health)
CLINIC_NAME=

# Reports
# Secret used to sign and verify JWT report tokens
REPORT_TOKEN_SECRET=

# Cron jobs — set by Vercel, or manually for local testing
CRON_SECRET=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Upstash Redis (SMS rate limiting — optional in local dev, required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Email alerts (optional — used by SMS cost alert cron)
# Sign up at https://resend.com — free tier covers low-volume alerts
RESEND_API_KEY=

# --- S2 Review Engine ---
REVIEW_TOKEN_SECRET=                 # 32+ random hex chars, separate from WIDGET_SESSION_SECRET
REVIEW_BASE_URL=http://localhost:3000
REVIEW_TEST_MODE=true                # true in dev; false in production
REVIEW_TEST_RECIPIENT_EMAIL=         # required when REVIEW_TEST_MODE=true
REVIEW_TEST_RECIPIENT_PHONE=         # required when REVIEW_TEST_MODE=true (E.164)
RESEND_WEBHOOK_SECRET=               # from Resend dashboard webhook config

# --- SMS Review V2 ---
# V-Health Google review URL — get the real value from Google Maps "Write a review" link
# Format: https://search.google.com/local/writereview?placeid=<PLACE_ID>
VHEALTH_GOOGLE_REVIEW_URL=https://www.google.com/maps/place/V-Health+Rehab/...?writereview
